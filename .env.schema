# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# PostgreSQL Username
POSTGRES_USER=admin

# PostgreSQL Password
# @sensitive
POSTGRES_PASSWORD=

# PostgreSQL Database Name
POSTGRES_DB=albumz

# @sensitive
JWT_SECRET=

# JWT Expiration in seconds
# @type=string(endsWith=s,minLength=5)
JWT_EXPIRES_IN=3600s

# Public URL the app is served from (used for CORS and SvelteKit CSRF)
# @type=url
ORIGIN=http://localhost:3000
